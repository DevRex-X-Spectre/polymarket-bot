# Copy to .env for local use. Never commit .env or real credentials.
# Default mode is research. Live trading is disabled in this repository.

# research | paper | live
POLYMARKET_BOT_MODE=research

# Live trading additionally requires this exact value AND human authorization.
# Leave false. The application cannot submit live orders in the current build.
POLYMARKET_BOT_LIVE_TRADING_ENABLED=false

# development | test | production
NODE_ENV=development

# Opt-in live Gamma HTTP tests. Leave unset/false in CI.
# POLYMARKET_BOT_LIVE_NETWORK_TESTS=false

# Future secret slots (leave empty). Do not paste private keys here.
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
# POLYMARKET_PRIVATE_KEY=
# DATABASE_URL=
